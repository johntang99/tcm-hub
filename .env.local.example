# Copy this file to .env.local and fill in your values

# Site Configuration
NEXT_PUBLIC_DEFAULT_SITE=dr-huang-clinic
APP_ENV=dev
NEXT_PUBLIC_APP_ENV=dev

# Supabase (default)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional environment-specific Supabase endpoints
SUPABASE_STAGING_URL=
NEXT_PUBLIC_SUPABASE_STAGING_URL=
SUPABASE_STAGING_SERVICE_ROLE_KEY=
SUPABASE_PROD_URL=
NEXT_PUBLIC_SUPABASE_PROD_URL=
SUPABASE_PROD_SERVICE_ROLE_KEY=

# Admin auth
JWT_SECRET=change-me

# Admin Authentication (Phase 6)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-secure-password

# Google Services (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# Email Configuration (Phase 6 - Contact Forms)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Notifications
# RESEND_API_KEY=
# RESEND_FROM=
# CONTACT_FALLBACK_TO=
# ALERT_TO=

# BAAM Review integration — auto-queue confirmed bookings for review requests.
# Get the API key from BAAM Review → Location Setup → Integrations · API keys.
# Leave BAAM_REVIEW_API_KEY blank to disable the integration.
# BAAM_REVIEW_API_KEY=brk_xxxxxxxxxxxxxxxxxxxx
# BAAM_REVIEW_API_URL=https://baamreview.com
# BAAM_REVIEW_LANGUAGE=zh

# AI Rewrite Providers
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_REWRITE_PROVIDER=openai
# AI_REWRITE_CLAUDE_MODEL=claude-sonnet-4-6
# AI_REWRITE_OPENAI_MODEL=gpt-5.4
# Optional legacy aliases also supported:
# ANTHROPIC_MAIN_MODEL=claude-sonnet-4-6
# OPENAI_MAIN_MODEL=gpt-5.4
